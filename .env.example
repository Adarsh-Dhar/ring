# ───────── REQUIRED in production ─────────
# Long random string (32+ chars). Signs every session token. Generate: openssl rand -hex 32
# Without it, NOTHING can sign in on a production server (fails closed).
AUTH_SECRET=
# 32-byte base64url-encoded key for encrypting Ring tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENC_KEY=
# Public https URL of this app (used for OAuth callbacks).
APP_URL=https://doorbell.example.com

# ───────── Ring Partner API ─────────
# HMAC signing key from Ring partner onboarding. Webhooks without a valid X-Signature are rejected.
RING_HMAC_KEY=
# Ring OAuth credentials (for account linking via OAuth flow)
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Ring token exchange endpoint (default: https://oauth.ring.com/oauth/token)
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
# Ring API base URL (default: https://api.amazonvision.com)
RING_API_BASE=https://api.amazonvision.com
# Which Ring events open a case. Real names: button_press, motion_detected.
# Default is doorbell presses only (motion would alert for every passer-by).
RING_TRIGGER_EVENTS=button_press

# ───────── Alerts ─────────
ESCALATION_SECONDS=30
# VAPID keys for web push notifications (REQUIRED). Generate: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# SMS is sent at the FIRST escalation step too (push alone is unreliable, especially on iPhone).
# Twilio credentials (REQUIRED for SMS alerts AND SMS OTP login)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
# For Twilio trial accounts: use a predefined template name (e.g., "sms_appointment_reminders")
# This template name is sent in the Body parameter, not ContentSid
# Leave empty for production accounts (allows custom message bodies)
TWILIO_TEMPLATE_NAME=
# Email OTP delivery via Resend (https://resend.com) – used when phone is not provided.
# Leave empty to skip email delivery (SMS-only mode).
RESEND_API_KEY=
RESEND_FROM=noreply@doorbell.example.com
CHECKIN_HOUR=10
CHECKIN_GRACE_MIN=60
# Language for read-aloud on the resident screen (hi-IN, ta-IN, en-IN ...)
NEXT_PUBLIC_SPEECH_LANG=en-IN

# ───────── Recurring expected visits ─────────
EXPECTED_TIMEOUT_SECONDS=60   # helper has this long to confirm before it becomes a normal alert
RECURRING_GRACE_MIN=15        # visit may arrive this early or late

# ───────── Database (PostgreSQL via Docker + Prisma ORM) ─────────
# REQUIRED for multi-household support
DATABASE_URL=postgresql://doorbell:devpassword@localhost:5433/doorbell
POSTGRES_PASSWORD=devpassword

# ───────── Hosting + alert health ─────────
# Public domain Caddy serves over https (docker-compose). Needed for web push and Ring webhooks.
DOMAIN=doorbell.example.com
# 1 = repeated SMS failures also show the "alerts may not reach you" notice. Leave 0 on a Twilio trial account.
ALERTS_REQUIRE_SMS=0

# ───────── Visit requests (public link feature) ─────────
# APP_URL is already set above and is used for the link sent to visitors.
# Visitor messages require a full Twilio account (not TWILIO_TEMPLATE_NAME) or RESEND_API_KEY for email.

# How long the rotating code step lasts (seconds). Shorter = more secure; longer = easier to read out.
VISIT_CODE_STEP_SEC=60
# How many wrong-code answers the resident gets before the case is treated as an unknown visitor.
VISIT_CODE_MAX_ATTEMPTS=2

# Rate limits for the public visit-request form (all optional; these are the defaults):
VISIT_REQ_PER_IP_HOUR=5         # max requests per IP per hour
VISIT_REQ_PER_CONTACT_DAY=3     # max requests per phone/email per day (per household)
VISIT_REQ_PER_LINK_DAY=50       # max requests per link per day
VISIT_REQ_MAX_OPEN=25           # max simultaneously pending requests per household
VISIT_REQ_MAX_WINDOW_H=12       # max visit window length (hours)
VISIT_REQ_MAX_DAYS_AHEAD=30     # how far ahead a request can be made
VISIT_REQ_TTL_H=48              # request expires after this many hours if unanswered
VISIT_REQ_RESEND_MAX=5          # max times a visitor may request a new status link
