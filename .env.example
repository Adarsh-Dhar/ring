# Optional. Seconds each helper has to answer before escalation.
ESCALATION_SECONDS=30
# Optional. Set to 0 to disable the simulator on deployed servers.
ENABLE_SIM=1
# Optional. Only needed once real Ring webhooks POST to /api/webhook.
# RING_WEBHOOK_SECRET=change_me
# Optional. Web Push VAPID keys for phone alerts. Run: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional. SMS fallback via Twilio
RESIDENT_NAME=Asha
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
# Optional. Daily check-in deadline hour (0-23)
CHECKIN_HOUR=10
CHECKIN_GRACE_MIN=60
# Optional. PIN required to access /setup. Leave empty to disable.
SETUP_PIN=
# Optional. Comma-separated list of Ring event types that trigger alerts.
RING_TRIGGER_EVENTS=person_detected,doorbell_pressed,ding
# Optional. Set to 1 to log webhook request bodies to console.
LOG_WEBHOOK_BODY=0
