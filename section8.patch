diff -ruN '--exclude=node_modules' '--exclude=.next' '--exclude=*.tsbuildinfo' ring-orig/app/helper/LifecyclePanel.tsx src/ring-main/app/helper/LifecyclePanel.tsx
--- a/app/helper/LifecyclePanel.tsx	1970-01-01 00:00:00.000000000 +0000
