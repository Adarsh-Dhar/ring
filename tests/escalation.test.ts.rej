+
+    expect(await escalateDueCase(c, T0 + 30_000, CFG, withCapture)).toBe(1)
+    expect(captured.timerKind).toBe(timerKind)
+    expect(captured.timerBehavior).toBe(expectedBehavior)
+  })
 
