generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  phone                 String?        @unique
  name                  String?
  createdAt             DateTime       @default(now())
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  googleSub             String?        @unique
  sessionVersion        Int            @default(1)
  acceptedInvites       Invite[]       @relation("AcceptedInvites")
  createdInvites        Invite[]       @relation("CreatedInvites")
  memberships           Membership[]
  sentNotifications     Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")
}

model Household {
  id                String             @id @default(cuid())
  residentName      String
  timezone          String             @default("Asia/Kolkata")
  timeoutSec        Int                @default(30)
  quietStartHour    Int                @default(22)
  quietEndHour      Int                @default(6)
  quietEnabled      Boolean            @default(false)
  emergencyNumber   String             @default("112")
  residentEpoch     Int                @default(1)
  createdAt         DateTime           @default(now())
  plannedMode       String             @default("helper")
  requireResidentOk Boolean            @default(false)
  preset            String             @default("standard")
  aiEnabled         Boolean            @default(true)
  aiGreeter         Boolean            @default(true)
  aiInterrogator    Boolean?           @default(true)
  minNoticeHours       Int?
  shortNoticePolicy    String             @default("helper_approval")
  approvalTimerSec     Int?
  approvalRetrySec     Int                @default(300)
  unknownVisitorPolicy String             @default("ai_first_contact")
  preferences          Json?              @db.Json
  quietPeriodMin       Int                @default(10)   // section 8.2: quiet period before an idle case closes (pilot default 10 minutes)
  priorLookbackHours   Int                @default(24)   // section 8.2: window for earlier serious events shown to the helper
  AiRun             AiRun[]
  cases             Case[]
  devices           Device[]
  expectedVisits    ExpectedVisit[]
  faceSightings     FaceSighting[]
  guestFaces        GuestFace[]
  invites           Invite[]
  memberships       Membership[]
  passes            Pass[]
  recurringVisits   RecurringVisit[]
  regularVisitors   RegularVisitor[]
  residentDevices   ResidentDevice[]
  ResidentNote      ResidentNote[]
  ringConnections   RingConnection[]
  v2Devices         V2Device[]
  visitRequests     VisitRequest[]
  visitRequestLinks VisitRequestLink[]
  webhookEvents     WebhookEvent[]
  WeeklyDigest      WeeklyDigest[]
}

model Membership {
  id                String             @id @default(cuid())
  userId            String
  householdId       String
  role              String
  consent           String             @default("pending")
  consentAt         DateTime?
  position          Int
  tokenEpoch        Int                @default(1)
  emoji             String             @default("🙂")
  tier              String             @default("primary")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
  v2Devices         V2Device[]
  helperRequests    HelperRequest[]

  @@unique([userId, householdId])
  @@index([householdId])
}

model HelperRequest {
  id            String    @id @default(cuid())
  caseId        String
  membershipId  String
  kind          String
  round         Int       @default(1)
  state         String    @default("sent")
  sentAt        DateTime  @default(now())
  deliveredAt   DateTime?
  ackedAt       DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  timedOutAt    DateTime?
  channels      Json      @default("{}")
  snapshot      Json?
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([membershipId])
  @@index([state])
}

model Notification {
  id          String    @id @default(cuid())
  type        String
  title       String
  message     String
  status      String    @default("pending")
  metadata    Json?
  read        Boolean   @default(false)
  readAt      DateTime?
  toUserId    String
  fromUserId  String?
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  fromUser    User?     @relation("SentNotifications", fields: [fromUserId], references: [id])
  toUser      User      @relation("ReceivedNotifications", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([toUserId, read])
}

model ResidentDevice {
  id               String    @id @default(cuid())
  householdId      String
  pairingCodeHash  String?   @unique
  deviceTokenEpoch Int       @default(1)
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model RingConnection {
  id                    String     @id @default(cuid())
  householdId           String?
  ringAccountId         String     @unique
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt             DateTime?
  status                String     @default("unclaimed")
  linkedByUserId        String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  household             Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([ringAccountId])
}

model Device {
  id           String    @id @default(cuid())
  householdId  String
  ringDeviceId String
  online       Boolean   @default(false)
  since        DateTime
  alertedAt    DateTime?
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, ringDeviceId])
  @@index([householdId])
}

model Case {
  id                   String    @id @default(cuid())
  householdId          String
  kind                 String
  eventType            String
  createdAt            DateTime  @default(now())
  helperIndex          Int       @default(0)
  deadlineAt           DateTime
  deadlineKind         String?                   // household | approval | risk_decision | takeover
  timerDeadlines       Json?                     // { approval?: ms, risk_decision?: ms, takeover?: ms }
  status               String    @default("waiting")
  answer               String?
  answeredBy           String?
  resolvedAt           DateTime?
  log                  Json      @default("[]")
  visitor              String?
  confirmedAt          DateTime?
  declinedAt           DateTime?
  chain                Json      @default("[]")
  deviceId             String?
  ackedBy              String?
  ackedAt              DateTime?
  lane                 String?
  recurringId          String?
  visitIcon            String?
  visitLabel           String?
  checkWho             String?
  checkWord            String?
  selfVerifiedAt       DateTime?
  checkAttempts        Int       @default(0)
  checkMode            String?
  expectedId           String?
  regularId            String?
  visitorSummary       String?
  riskFlags            Json      @default("[]")
  clipDescription      String?
  clipTags             Json?
  greeterState         String?
  clipActions          Json?     @default("[]")
  clipPeopleCount      Int?      @default(0)
  clipApproachedDoor   Boolean?  @default(false)
  riskLevel            String?
  riskAssessment       Json?
  interrogationState   String?
  interrogationTurns   Json?     @default("[]") @db.Json
  interrogationVerdict String?
  interrogationClaims  Json?     @db.Json
  noticeStatus         String?
  riskScore            Int?
  riskLedger           Json?     @db.Json
  riskObservations     Json?     @db.Json
  controlMode          String?       // event MINIMUM mode (spec 6.3), not the derived mode. S_eff = max(riskScore, floor of this)
  lastEventAt          DateTime?
  emergencyAlertedAt   DateTime?
  unconfirmedAlertedAt DateTime?
  urgentAlertedAt      DateTime?
  conversationOwner    String?       // userId of who owns the conversation (helper or AI)
  pendingActions       Json?
  // Section 8.1 lifecycle. Separate from `status`, which is the doorbell answer flow (waiting/answered/no_response).
  lifecycle            String    @default("open")   // open | helper_review | visitor_left | closed
  visitorLeftAt        DateTime?
  lastActivityAt       DateTime?                     // last event of any kind; the quiet period runs from here when no departure was recorded
  closedAt             DateTime?
  closedBy             String?                       // membership id, or "system" for the quiet-period close
  outcome              String?                       // resolved_safe | resolved_incident | false_alarm (helper close only)
  closeReason          String?
  possibleNewVisitorAt DateTime?                     // set when an event arrived after the visitor left or during the quiet period
  splitFromId          String?                       // case this one was split from
  household            Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  helperRequests       HelperRequest[]

  @@index([householdId])
  @@index([createdAt])
  @@index([householdId, lifecycle])
}

/// Section 8.2: every correction is also logged as labelled data for the validation tests (section 12).
model CorrectionLabel {
  id          String   @id @default(cuid())
  householdId String
  caseId      String
  obsId       String?
  code        String?
  action      String   // retract | resolve | dispute | confirm | restore | reset | statement | split | close
  actorRole   String   // helper | resident | system
  actorId     String?
  reason      String?
  scoreBefore Int?
  scoreAfter  Int?
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([householdId, createdAt])
}

model ExpectedVisit {
  id          String    @id @default(cuid())
  householdId String
  icon        String
  label       String
  startsAt    DateTime
  endsAt      DateTime
  passphrase  String?
  who         String?
  codeSecret  String?
  requestId   String?
  singleUse   Boolean   @default(false)
  usedAt      DateTime?
  arrangedAt  DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model RecurringVisit {
  id              String    @id @default(cuid())
  householdId     String
  icon            String
  label           String
  days            Json      @default("[]")
  everyNWeeks     Int       @default(1)
  anchorWeek      Int
  startMin        Int
  endMin          Int
  alertIfMissed   Boolean   @default(false)
  paused          Boolean   @default(false)
  lastArrived     String?
  lastMissedAlert String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  passphrase      String?
  who             String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model PushSubscription {
  id           String     @id @default(cuid())
  membershipId String
  endpoint     String
  keys         Json
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, endpoint])
  @@index([membershipId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  requestId   String    @unique
  householdId String
  receivedAt  DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([requestId])
}

model RingNonce {
  nonce  String   @id
  usedAt DateTime @default(now())
}

model Invite {
  id               String    @id @default(cuid())
  code             String    @unique
  householdId      String
  role             String    @default("helper")
  status           String    @default("pending")
  expiresAt        DateTime?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime  @default(now())
  acceptedBy       User?     @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id])
  createdBy        User      @relation("CreatedInvites", fields: [createdByUserId], references: [id])
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([code])
  @@index([status])
}

model VisitRequestLink {
  id              String           @id @default(cuid())
  householdId     String
  tokenHash       String           @unique
  createdByUserId String
  createdAt       DateTime         @default(now())
  revokedAt       DateTime?
  regularVisitors RegularVisitor[]
  requests        VisitRequest[]
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model VisitRequest {
  id              String           @id @default(cuid())
  householdId     String
  linkId          String
  name            String
  purpose         String
  note            String?
  contact         String
  contactKind     String
  startsAt        DateTime
  endsAt          DateTime
  status          String           @default("pending")
  helperOkBy      String?
  helperOkAt      DateTime?
  residentOkAt    DateTime?
  decidedAt       DateTime?
  expectedVisitId String?
  statusToken     String           @unique
  deviceHash      String?
  resendCount     Int              @default(0)
  ip              String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
  intakeId        String?
  riskNote        String?
  VisitIntake     VisitIntake?
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  link            VisitRequestLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
  @@index([ip, createdAt])
  @@index([linkId, createdAt])
  @@index([householdId, contact, createdAt])
}

model GuestFace {
  id          String    @id @default(cuid())
  householdId String
  name        String
  ref         String?
  embedding   String
  consentAt   DateTime
  createdBy   String?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([householdId, ref])
}

model FaceSighting {
  id          String    @id @default(cuid())
  householdId String
  caseId      String?
  deviceId    String?
  source      String
  capturedAt  DateTime  @default(now())
  faceCount   Int
  faces       Json      @default("[]")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, capturedAt])
  @@index([caseId])
}

/// A person who registered their face through the public link to become a "regular visitor".
/// pending -> approved (a helper OR the resident said yes) | declined | cancelled | expired | removed.
/// While pending we keep an encrypted thumbnail so the approver can SEE who it is; it is erased on any decision.
/// On approval the descriptor is copied into GuestFace (ref = "reg:<id>"), which the camera matcher already reads.
model RegularVisitor {
  id          String           @id @default(cuid())
  householdId String
  linkId      String
  name        String
  purpose     String
  note        String?
  contact     String
  contactKind String
  status      String           @default("pending")
  embedding   String?
  photoEnc    String?
  consentAt   DateTime
  decidedBy   String?
  decidedAt   DateTime?
  faceId      String?
  statusToken String           @unique
  ip          String?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  link        VisitRequestLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
  @@index([ip, createdAt])
  @@index([linkId, createdAt])
  @@index([householdId, contact, createdAt])
}

model V2Device {
  id          String      @id @default(cuid())
  householdId String
  memberId    String?
  kind        String
  publicKey   String
  lastSeenAt  DateTime    @default(now())
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  passes      Pass[]
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  membership  Membership? @relation(fields: [memberId], references: [id])

  @@index([householdId])
  @@index([memberId])
}

model Pass {
  id              String      @id @default(cuid())
  householdId     String
  visitorName     String
  windowStart     DateTime
  windowEnd       DateTime
  recurrence      Json?
  deviceId        String?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  secretHash      String?     @unique
  boundDeviceHash String?
  boundAt         DateTime?
  device          V2Device?   @relation(fields: [deviceId], references: [id])
  household       Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events          PassEvent[]

  @@index([householdId])
  @@index([windowStart, windowEnd])
}

model PassEvent {
  id       String   @id @default(cuid())
  passId   String
  type     String
  deviceId String?
  at       DateTime @default(now())
  pass     Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@index([passId])
  @@index([at])
}

model AiRun {
  id          String    @id @default(cuid())
  householdId String
  agent       String
  model       String
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  latencyMs   Int       @default(0)
  status      String
  caseId      String?
  createdAt   DateTime  @default(now())
  Household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([agent, createdAt])
  @@index([householdId, createdAt])
}

model ResidentNote {
  id          String    @id @default(cuid())
  householdId String
  rawNote     String
  draftText   String
  icon        String
  status      String    @default("draft")
  approvedBy  String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  Household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
}

model VisitIntake {
  id           String       @id @default(cuid())
  requestId    String       @unique
  turns        Json         @default("[]")
  claims       Json         @default("{}")
  verdict      String?
  mismatches   Json         @default("[]")
  status       String       @default("open")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  VisitRequest VisitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model WeeklyDigest {
  id          String    @id @default(cuid())
  householdId String
  weekStart   DateTime
  facts       Json
  text        String
  createdAt   DateTime  @default(now())
  Household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, weekStart])
}
