# ───────── REQUIRED in production ─────────
# Long random string. Signs every helper/resident link. Generate: openssl rand -hex 32
# Without it, NOTHING can sign in on a production server (fails closed).
AUTH_SECRET=
# Guardian PIN for /setup. Without it, setup is locked in production.
ADMIN_PIN=
# Public https URL of this app (used to build sign-in links).
APP_URL=https://doorbell.example.com
# The resident's time zone. Quiet hours and the daily check-in use THIS, not the server clock.
RESIDENT_TZ=Asia/Kolkata
RESIDENT_NAME=Asha

# ───────── Ring Partner API ─────────
# HMAC signing key from Ring partner onboarding. Webhooks without a valid X-Signature are rejected.
RING_HMAC_KEY=
# Only accept events from this Ring account (meta.account_id), e.g. ava1.ring.account.XXXX
RING_ACCOUNT_ID=
# Comma-separated Ring device ids to health-check. Leave empty to check every shared device.
RING_DEVICE_IDS=
# Which Ring events open a case. Real names: button_press, motion_detected.
# Default is doorbell presses only (motion would alert for every passer-by).
RING_TRIGGER_EVENTS=button_press
# Tokens for calling the Ring API (status checks, live video):
#  production: refresh flow (verify against Ring's Token Exchange doc)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# ───────── Alerts ─────────
ESCALATION_SECONDS=30
EMERGENCY_NUMBER=112
# VAPID keys for web push notifications (REQUIRED). Generate: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# SMS is sent at the FIRST escalation step too (push alone is unreliable, especially on iPhone).
# Twilio credentials (REQUIRED)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
# For Twilio trial accounts: use a predefined template name (e.g., "sms_appointment_reminders")
# This template name is sent in the Body parameter, not ContentSid
# Leave empty for production accounts (allows custom message bodies)
TWILIO_TEMPLATE_NAME=
CHECKIN_HOUR=10
CHECKIN_GRACE_MIN=60
# Language for read-aloud on the resident screen (hi-IN, ta-IN, en-IN ...)
NEXT_PUBLIC_SPEECH_LANG=en-IN

# ───────── Recurring expected visits ─────────
EXPECTED_TIMEOUT_SECONDS=60   # helper has this long to confirm before it becomes a normal alert
RECURRING_GRACE_MIN=15        # visit may arrive this early or late

# ───────── Database (PostgreSQL via Docker + Prisma ORM 8) ─────────
# Leave empty to keep using data/state.json (tests, quick local runs).
DATABASE_URL=postgresql://doorbell:devpassword@localhost:5433/doorbell
POSTGRES_PASSWORD=devpassword

# ───────── Storage ─────────
# Directory for state.json (phone numbers, case history). Use a persistent, encrypted volume.
DATA_DIR=./data

# ───────── Hosting + alert health (added) ─────────
# Public domain Caddy serves over https (docker-compose). Needed for web push and Ring webhooks.
DOMAIN=doorbell.example.com
# 1 = repeated SMS failures also show the "alerts may not reach you" notice. Leave 0 on a Twilio trial account.
ALERTS_REQUIRE_SMS=0
