generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String?      @unique
  phone           String?      @unique
  name            String?
  createdAt       DateTime     @default(now())
  acceptedInvites Invite[]     @relation("AcceptedInvites")
  createdInvites  Invite[]     @relation("CreatedInvites")
  memberships     Membership[]
  otpCodes        OtpCode[]
}

model Household {
  id                String             @id @default(cuid())
  residentName      String
  timezone          String             @default("Asia/Kolkata")
  timeoutSec        Int                @default(30)
  quietStartHour    Int                @default(22)
  quietEndHour      Int                @default(6)
  quietEnabled      Boolean            @default(false)
  emergencyNumber   String             @default("112")
  residentEpoch     Int                @default(1)
  createdAt         DateTime           @default(now())
  plannedMode       String             @default("helper")
  requireResidentOk Boolean            @default(false)
  cases             Case[]
  devices           Device[]
  expectedVisits    ExpectedVisit[]
  guestFaces        GuestFace[]
  faceSightings     FaceSighting[]
  invites           Invite[]
  memberships       Membership[]
  recurringVisits   RecurringVisit[]
  residentDevices   ResidentDevice[]
  ringConnections   RingConnection[]
  visitRequests     VisitRequest[]
  visitRequestLinks VisitRequestLink[]
  webhookEvents     WebhookEvent[]
}

model Membership {
  id                String             @id @default(cuid())
  userId            String
  householdId       String
  role              String
  consent           String             @default("pending")
  consentAt         DateTime?
  position          Int
  tokenEpoch        Int                @default(1)
  emoji             String             @default("🙂")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@unique([userId, householdId])
  @@index([householdId])
}

model ResidentDevice {
  id               String    @id @default(cuid())
  householdId      String
  pairingCodeHash  String    @unique
  deviceTokenEpoch Int       @default(1)
  lastSeenAt       DateTime?
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model RingConnection {
  id                    String     @id @default(cuid())
  householdId           String?
  ringAccountId         String     @unique
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt             DateTime?
  status                String     @default("unclaimed")
  linkedByUserId        String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  household             Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([ringAccountId])
}

model Device {
  id           String    @id @default(cuid())
  householdId  String
  ringDeviceId String
  online       Boolean   @default(false)
  since        DateTime
  alertedAt    DateTime?
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, ringDeviceId])
  @@index([householdId])
}

model Case {
  id             String    @id @default(cuid())
  householdId    String
  kind           String
  eventType      String
  createdAt      DateTime  @default(now())
  helperIndex    Int       @default(0)
  deadlineAt     DateTime
  status         String    @default("waiting")
  answer         String?
  answeredBy     String?
  resolvedAt     DateTime?
  log            Json      @default("[]")
  visitor        String?
  confirmedAt    DateTime?
  declinedAt     DateTime?
  chain          Json      @default("[]")
  deviceId       String?
  ackedBy        String?
  ackedAt        DateTime?
  lane           String?
  recurringId    String?
  visitIcon      String?
  visitLabel     String?
  checkWho       String?
  checkWord      String?
  selfVerifiedAt DateTime?
  checkAttempts  Int       @default(0)
  checkMode      String?
  expectedId     String?
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([createdAt])
}

model ExpectedVisit {
  id          String    @id @default(cuid())
  householdId String
  icon        String
  label       String
  startsAt    DateTime
  endsAt      DateTime
  passphrase  String?
  who         String?
  codeSecret  String?
  requestId   String?
  singleUse   Boolean   @default(false)
  usedAt      DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model RecurringVisit {
  id              String    @id @default(cuid())
  householdId     String
  icon            String
  label           String
  days            Json      @default("[]")
  everyNWeeks     Int       @default(1)
  anchorWeek      Int
  startMin        Int
  endMin          Int
  alertIfMissed   Boolean   @default(false)
  paused          Boolean   @default(false)
  lastArrived     String?
  lastMissedAlert String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  passphrase      String?
  who             String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model PushSubscription {
  id           String     @id @default(cuid())
  membershipId String
  endpoint     String
  keys         Json
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, endpoint])
  @@index([membershipId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  requestId   String    @unique
  householdId String
  receivedAt  DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([requestId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model RingNonce {
  nonce  String   @id
  usedAt DateTime @default(now())
}

model Invite {
  id               String    @id @default(cuid())
  code             String    @unique
  householdId      String
  role             String    @default("helper")
  status           String    @default("pending")
  expiresAt        DateTime?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime  @default(now())
  acceptedBy       User?     @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id])
  createdBy        User      @relation("CreatedInvites", fields: [createdByUserId], references: [id])
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([code])
  @@index([status])
}

model VisitRequestLink {
  id              String         @id @default(cuid())
  householdId     String
  tokenHash       String         @unique
  createdByUserId String
  createdAt       DateTime       @default(now())
  revokedAt       DateTime?
  requests        VisitRequest[]
  household       Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model VisitRequest {
  id              String           @id @default(cuid())
  householdId     String
  linkId          String
  name            String
  purpose         String
  note            String?
  contact         String
  contactKind     String
  startsAt        DateTime
  endsAt          DateTime
  status          String           @default("pending")
  helperOkBy      String?
  helperOkAt      DateTime?
  residentOkAt    DateTime?
  decidedAt       DateTime?
  expectedVisitId String?
  statusToken     String           @unique
  deviceHash      String?
  resendCount     Int              @default(0)
  ip              String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  link            VisitRequestLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
  @@index([ip, createdAt])
  @@index([linkId, createdAt])
  @@index([householdId, contact, createdAt])
}

model GuestFace {
  id          String    @id @default(cuid())
  householdId String
  name        String
  ref         String?
  embedding   String
  consentAt   DateTime
  createdBy   String?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([householdId, ref])
}

model FaceSighting {
  id          String    @id @default(cuid())
  householdId String
  caseId      String?
  deviceId    String?
  source      String
  capturedAt  DateTime  @default(now())
  faceCount   Int
  faces       Json      @default("[]")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, capturedAt])
  @@index([caseId])
}
