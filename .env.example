# Ring API Configuration
# Choose ONE authentication method (access_token OR refresh_token)
RING_ACCESS_TOKEN=your_ring_access_token_here
# RING_REFRESH_TOKEN=your_ring_refresh_token_here

# Optional: Skip device discovery by specifying device ID
NEXT_PUBLIC_RING_DEVICE_ID=ava1.ring.device.XXX

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Demo Mode Configuration
# Set to true to use local sample videos instead of calling Ring API
# DEMO_MODE=true
