# ───────── REQUIRED in production ─────────
AUTH_SECRET=
ADMIN_PIN=
APP_URL=http://localhost:3000
RESIDENT_TZ=Asia/Kolkata
RESIDENT_NAME=Asha

# ───────── Ring Partner API ─────────
RING_HMAC_KEY=
RING_ACCOUNT_ID=
RING_DEVICE_IDS=
RING_TRIGGER_EVENTS=button_press
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# ───────── Alerts ─────────
ESCALATION_SECONDS=30
EMERGENCY_NUMBER=112
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
CHECKIN_HOUR=10
CHECKIN_GRACE_MIN=60
NEXT_PUBLIC_SPEECH_LANG=en-IN

# ───────── Recurring expected visits ─────────
EXPECTED_TIMEOUT_SECONDS=60
RECURRING_GRACE_MIN=15

# ───────── Storage ─────────
DATA_DIR=/data

# ───────── Local Video ─────────
LOCAL_VIDEO=0
VIDEOS_DIR=./videos

# ───────── Development only (all ignored when NODE_ENV=production) ─────────
ENABLE_SIM=0
SEED_DEMO_HELPERS=0
ALLOW_UNSIGNED_WEBHOOK=0
ALLOW_DEV_AUTH=0
LOG_WEBHOOK_BODY=0

# ───────── Database (PostgreSQL) ─────────
# Do not set DATABASE_URL here - docker-compose.yml sets it with the in-network hostname
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24

# ───────── Hosting + alert health (added) ─────────
# Public domain Caddy serves over https (docker-compose). Needed for web push and Ring webhooks.
DOMAIN=doorbell.example.com
# 1 = repeated SMS failures also show the "alerts may not reach you" notice. Leave 0 on a Twilio trial account.
ALERTS_REQUIRE_SMS=0

# Set automatically by docker-compose (Caddy is the only way in). Do not set this if the app is reachable directly.
# TRUST_PROXY=1
