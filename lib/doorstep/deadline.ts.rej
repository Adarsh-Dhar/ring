+
+/**
+ * Clear every acknowledgement timer for a no-timer state such as a confirmed emergency.
+ * `deadlineAt` remains non-null for legacy/schema compatibility, but is only a sentinel: the
+ * scheduler must ignore it whenever deadlineKind is `none` or `emergency`.
+ * The compare-and-set includes all timer-index fields so a concurrent timer update cannot be lost.
+ */
+export async function clearAllTimerDeadlines(
+  householdId: string,
+  caseId: string,
+  reason: string,
+  state: 'none' | 'emergency' = 'none',
+  now = Date.now(),
+): Promise<boolean> {
+  const db = getDb()
+  const sentinel = now + NO_ACTIVE_TIMER_SENTINEL_MS
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const row = await db.case.findUnique({
+      where: { id: caseId },
+      select: { deadlineAt: true, deadlineKind: true, status: true, timerDeadlines: true },
+    })
+    if (!row || row.status !== 'waiting') return false
+
+    const currentMap = legacyTimerMap(row)
+    if (row.deadlineKind === state && Object.keys(currentMap).length === 0) return false
+
+    const update = await db.case.updateMany({
+      where: {
+        id: caseId,
+        status: 'waiting',
+        deadlineAt: row.deadlineAt,
+        deadlineKind: row.deadlineKind,
+        timerDeadlines: prismaJsonCompare(row.timerDeadlines),
+      },
+      data: {
+        deadlineAt: new Date(sentinel),
+        deadlineKind: state,
+        timerDeadlines: {} as Prisma.InputJsonValue,
+      },
+    })
+
+    if (update.count === 1) {
+      const { syncCaseDeadline } = await import('@/lib/doorbell/store')
+      syncCaseDeadline(householdId, caseId, sentinel, state, {})
+      await writeAudit(caseId, createAuditEvent('system', 'timers_cleared', {
+        reason, state, clearedKinds: Object.keys(currentMap),
       })).catch(() => {})
       return true
     }
