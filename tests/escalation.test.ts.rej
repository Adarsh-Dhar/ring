+  it('re-arms a low-score AI-action risk timer with 120 - S_eff, not household timeout', async () => {
+    const c = mkCase({
+      deadlineAt: T0 + 5_000,
+      deadlineKind: 'risk_decision',
+      timerDeadlines: { risk_decision: T0 + 5_000 },
+      riskScore: 5,
+      controlMode: 'ai_leads',
+    } as Partial<DoorCase>)
+    const db = fakeDb(rowOf(c))
+    const cfg = { ...CFG, timeoutSec: 30, timerSeconds: { household: 30, risk_decision: 115 } }
+
+    expect(await escalateDueCase(c, T0 + 5_000, cfg, db.deps('A'))).toBe(1)
+    expect(c.timerDeadlines).toEqual({ risk_decision: T0 + 120_000 })
+    expect(c.deadlineAt).toBe(T0 + 120_000)
+    expect(c.deadlineKind).toBe('risk_decision')
+  })
